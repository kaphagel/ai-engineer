{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iaiep:skill:engineering.requirement-analysis:input:0.1.0",
  "title": "Requirement analysis input",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "source_artifacts", "target"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "revision", "classification", "kind"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
          "kind": {
            "description": "Document kind. Only pre-design documents may be used for the F-3 test (spec §1.2).",
            "enum": ["customer_specification", "process_data", "design_basis", "data_sheet", "meeting_notes", "standard_extract", "other_pre_design"]
          },
          "title": { "type": "string" }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "fields"],
      "properties": {
        "schema_id": { "type": "string", "description": "Input-set schema owned by a domain package, e.g. esp.hopper-input-set" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "quantity", "unit", "criticality"],
            "properties": {
              "field": { "type": "string", "description": "Path in the target schema, e.g. parameters.height_mm" },
              "quantity": { "type": "string", "description": "Quantity type, e.g. length, temperature, text" },
              "unit": { "type": "string", "description": "Target unit; empty string for dimensionless or text" },
              "criticality": { "enum": ["critical", "non_critical"] },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
